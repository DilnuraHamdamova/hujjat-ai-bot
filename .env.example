APP_ENV=development
LOG_LEVEL=INFO

# BotFather token is required to run the Telegram bot.
BOT_TOKEN=123456789:REPLACE_WITH_BOTFATHER_TOKEN
BOT_MODE=polling
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=change-this-secret

DATABASE_URL=postgresql+asyncpg://cvbot:cvbot@postgres:5432/cvbot
REDIS_URL=redis://redis:6379/0
STORAGE_DIR=/app/storage

# Reserved for the later AI integration. Empty is valid for the text-only MVP.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

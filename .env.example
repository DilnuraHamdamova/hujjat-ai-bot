APP_ENV=development
LOG_LEVEL=INFO

# BotFather token is required to run the Telegram bot.
BOT_TOKEN=123456789:REPLACE_WITH_BOTFATHER_TOKEN
BOT_MODE=polling
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=change-this-secret
TEMPLATE_WEBAPP_URL=

DATABASE_URL=postgresql+asyncpg://cvbot:cvbot@postgres:5432/cvbot
REDIS_URL=redis://redis:6379/0
STORAGE_DIR=/app/storage

# Gemini powers voice/audio transcription. Text answers still work without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
GEMINI_VOICE_MODEL=gemini-3.5-transcribe
